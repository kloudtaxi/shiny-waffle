    \"requestor\": \"sarah.chen@northstar.example\",\n    \"basis\": \"contract_exception\"\n  },\n  \"commercial_eligibility\": {\n    \"status\": \"unknown\",\n    \"maximum_discount\": null,\n    \"basis\": \"Contract terms not located\"\n  },\n  \"authority\": {\n    \"policy\": \"PRICING-POLICY-2026\",\n    \"requestor_limit\": 10,\n    \"requestor_authorized\": false,\n    \"required_role\": \"VP Sales\",\n    \"approver\": \"michael.torres@northstar.example\"\n  },\n  \"evidence\": [\n    \"PRICING-POLICY-2026 (in force on request date 2026-09-23)\",\n    \"Approval Authority Matrix APP-MATRIX-2026\",\n    \"Sarah Chen confirmed as Enterprise Account Executive (EMP-101)\",\n    \"Michael Torres confirmed as VP Sales (EMP-200)\",\n    \"Request DR-9001 recorded in Northstar CRM\"\n  ],\n  \"missing_evidence\": [\n    \"Acme Master Supply Agreement (cited in justification; not found in OWM register)\",\n    \"Pricing exception for NS-500 (if any; not found in OWM register)\"\n  ],\n  \"conditions\": [\n    {\n      \"what\": \"Provide the Acme Master Supply Agreement or equivalent evidence of the contract pricing terms cited in the request justification\",\n      \"who\": \"sarah.chen@northstar.example\",\n      \"blocking\": true\n    }\n  ]\n}\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":9,"cache_creation_input_tokens":4533,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4533},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c9807853-b841-496b-84ce-20c770ac845d","uuid":"8319a9b2-8b0b-4789-86ab-dc48073e0145","timestamp":"2026-10-08T10:55:51.324Z","request_id":"req_011CfpeX8AYxJTqKX6qx86TP"}
