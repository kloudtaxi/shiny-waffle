  "cards": [
    { "dot": "amber", "title": "Build gate", "items": [
      "assemble() runs the oracle on every scenario against its own corpus",
      "Any mismatch raises IncoherentTruthError and nothing is written",
      "Same seed gives a byte-identical dataset/"
    ] },
    { "dot": "emerald", "title": "OWM service", "items": [
      "Every decision appends to a SQLite event log in OWM_STATE_DIR",
      "A replay miss or kernel failure returns 503 cannot_decide",
      "Jev goes live only with OWM_JEV=live, up to OWM_JEV_CAP calls",
      "/lab/* demo routes: on locally, off in the image"
    ] },
    { "dot": "rose", "title": "Isolation", "items": [
      "The image copies 4 lab packages, the evidence and the Jev recordings",
      "No truth/, answer key, evaluation sheets, src/ or site/ in it",
      "The service accepts an admission report; it never runs the gate"
    ] }
